<?xml version="1.0" encoding="utf-8"?>
<!-- Orange initials circle; a white ring with a small gap marks focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="3dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="oval">
                    <solid android:color="#F26419" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#F26419" />
        </shape>
    </item>
</selector>
