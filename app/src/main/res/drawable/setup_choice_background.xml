<?xml version="1.0" encoding="utf-8"?>
<!-- A choice on the setup welcome screen: an outline, filled with a Halqa-orange ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#343943" /><stroke android:width="2dp" android:color="#F26419" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="#4A505A" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
