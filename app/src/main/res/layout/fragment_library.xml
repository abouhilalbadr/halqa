<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262A30">

    <!-- Scrolls when the Mac row and both Telegram rows don't fit; focus moving down brings rows into view. -->
    <ScrollView
        android:id="@+id/library_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/library_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_halqa_mark"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_sign_in"
                style="@style/Halqa.Pill"
                android:layout_marginEnd="12dp"
                android:text="@string/library_sign_in_telegram"
                android:visibility="gone" />

            <TextView
                android:id="@+id/library_account"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/account_avatar_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_mac_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="22dp"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_on_your_mac"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_mac_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#8A909A"
                android:textSize="13sp" />

            <!-- Spins while the Mac is re-read behind the list already shown. -->
            <com.saiesh.tele.presentation.widget.SpinnerView
                android:id="@+id/library_mac_checking"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                app:spinnerColor="#8A909A"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/library_mac_row"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="12dp"
            android:paddingEnd="48dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/library_new_title"
            style="@style/Halqa.RowTitle"
            android:layout_marginTop="14dp"
            android:text="@string/library_new_episodes" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/library_new_row"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="10dp"
            android:paddingEnd="48dp" />

        <TextView
            android:id="@+id/library_series_title"
            style="@style/Halqa.RowTitle"
            android:layout_marginTop="8dp"
            android:text="@string/library_all_series" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/library_series_row"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="10dp"
            android:paddingEnd="48dp" />
    </LinearLayout>
    </ScrollView>

    <com.saiesh.tele.presentation.widget.SpinnerView
        android:id="@+id/library_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/library_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/step_number_background">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_halqa_mark"
                android:tint="#F26419" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/library_empty"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/library_empty_message"
            android:textColor="#B6BCC6"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/library_refresh"
                style="@style/Halqa.Pill"
                android:paddingStart="24dp"
                android:paddingTop="11dp"
                android:paddingEnd="24dp"
                android:paddingBottom="11dp"
                android:text="@string/library_refresh" />

            <TextView
                android:id="@+id/library_add_mac"
                style="@style/Halqa.Pill"
                android:layout_marginStart="12dp"
                android:paddingStart="24dp"
                android:paddingTop="11dp"
                android:paddingEnd="24dp"
                android:paddingBottom="11dp"
                android:text="@string/mac_add_title" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
