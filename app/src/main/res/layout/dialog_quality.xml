<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quality_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8C0A0C0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/quality_sheet_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="22dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quality_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFF"
                android:textDirection="firstStrong"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quality_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#C3C8D1"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quality_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
