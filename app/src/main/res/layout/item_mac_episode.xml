<?xml version="1.0" encoding="utf-8"?>
<!-- An episode of a Mac title: a still from the video under a dark fade, its number, length and progress. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/video_card_background"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/mac_episode_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/mac_episode_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/episode_tile_scrim" />

    <TextView
        android:id="@+id/mac_episode_watched"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/video_card_badge"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="@string/mac_watched"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mac_episode_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/mac_episode_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mac_episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="#E6E9EE"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/mac_episode_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|start"
        android:background="#F26419"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/video_card_focus_ring"
        android:duplicateParentState="true" />
</FrameLayout>
