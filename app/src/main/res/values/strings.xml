    <!-- First-launch setup guide: pick Telegram, a computer or both, then follow the steps. -->
    <string name="setup_welcome_title">Welcome to Halqa</string>
    <string name="setup_welcome_body">Watch your series on this TV, from Telegram, a computer at home, or both. Where are your videos?</string>
    <string name="setup_choice_telegram">Telegram</string>
    <string name="setup_choice_computer">My computer</string>
    <string name="setup_choice_both">Both</string>
    <string name="setup_welcome_hint">Telegram needs your account and phone · My computer needs a Mac or PC on the same Wi-Fi</string>
    <string name="setup_step_of">Step %1$d of %2$d</string>
    <string name="setup_next">Next</string>
    <string name="setup_back">Back</string>
    <string name="setup_get_key_title">Get your Telegram key</string>
    <string name="setup_get_key_subtitle">Telegram asks every app for its own key. It\'s free and done once, on your phone.</string>
    <string name="setup_get_key_step_1">Scan the code with your phone\'s camera</string>
    <string name="setup_get_key_step_2">Sign in with your phone number. The code arrives in <b>Telegram</b>, not by SMS</string>
    <string name="setup_get_key_step_3">Open <b>API development tools</b></string>
    <string name="setup_get_key_step_4">Type any app name and short name, then tap <b>Create application</b></string>
    <string name="setup_get_key_site" translatable="false">my.telegram.org</string>
    <string name="setup_enter_key_title">Enter your key</string>
    <string name="setup_enter_key_subtitle">Copy <b>App api_id</b> and <b>App api_hash</b> from that page.</string>
    <string name="setup_api_id_hint" translatable="false">api_id</string>
    <string name="setup_api_hash_hint" translatable="false">api_hash</string>
    <string name="setup_enter_key_phone">Or scan with your phone and paste it there</string>
    <string name="setup_key_invalid">Check the key: api_id is a number, and api_hash has 32 letters and digits.</string>
    <string name="setup_key_rejected">Telegram didn\'t accept that key. Check both values and enter them again.</string>
    <string name="setup_sign_in_title">Sign in to Telegram</string>
    <string name="setup_signed_in">Signed in as %1$s</string>
    <string name="setup_need_title">What you need</string>
    <string name="setup_need_1">A Mac or Windows PC on the same Wi-Fi as this TV</string>
    <string name="setup_need_2">A folder named <b>Halqa</b> with your videos</string>
    <string name="setup_need_3">One folder per series, for example Halqa › Series name › E01.mp4</string>
    <string name="setup_need_4">Your user name and password on that computer</string>
    <string name="setup_share_title">Share the Halqa folder</string>
    <string name="setup_share_mac">System Settings › General › Sharing: turn on File Sharing and add the Halqa folder. Then Options › tick your user under Windows File Sharing.</string>
    <string name="setup_share_windows">Right-click the Halqa folder › Properties › Sharing › Share. The PC\'s address is in Settings › Network and internet › Properties (IPv4 address).</string>
    <string name="setup_share_awake">Keep the computer awake while you watch.</string>
