<?xml version="1.0" encoding="utf-8"?>
<!-- The progress knob grows and gets an orange ring while the bar has focus, as the cue that ◀ ▶ seek. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="3dp"
                android:color="#F26419" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="14dp"
                android:height="14dp" />
        </shape>
    </item>
</selector>
