<?xml version="1.0" encoding="utf-8"?>
<!-- Setup, computer: how to share the Halqa folder on a Mac and on Windows, side by side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
        style="@style/Halqa.SetupTitle"
        android:text="@string/setup_share_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/setup_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_os_mac"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/share_mac_title"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_share_mac"
                android:textAlignment="viewStart"
                android:textColor="#D8DCE2"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/setup_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_os_windows"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/share_windows_title"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_share_windows"
                android:textAlignment="viewStart"
                android:textColor="#D8DCE2"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Halqa.SetupSubtitle"
        android:layout_marginTop="18dp"
        android:text="@string/setup_share_awake" />
</LinearLayout>
