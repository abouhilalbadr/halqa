<?xml version="1.0" encoding="utf-8"?>
<!-- Add your computer: how to share a folder on the left; the computers found and the sign-in fields on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262A30"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="44dp"
    android:paddingEnd="44dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_halqa_mark"
            android:drawablePadding="8dp"
            android:drawableTint="#F26419"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mac_add_title"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Each step's number sits level with the step's first line. Step 1 shows how to share on each computer type. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                style="@style/Halqa.StepNumber"
                android:text="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/step_text_offset"
                    android:text="@string/mac_add_step_1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/share_howto_background"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_os_mac"
                            android:drawablePadding="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:text="@string/share_mac_title"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/share_mac_steps"
                            android:maxLines="2"
                            android:textColor="#D8DCE2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/share_howto_background"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_os_windows"
                            android:drawablePadding="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:text="@string/share_windows_title"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/share_windows_steps"
                            android:maxLines="2"
                            android:textColor="#D8DCE2"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                style="@style/Halqa.StepNumber"
                android:text="2" />

            <TextView
                style="@style/Halqa.Step"
                android:layout_marginTop="@dimen/step_text_offset"
                android:text="@string/mac_add_step_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                style="@style/Halqa.StepNumber"
                android:text="3" />

            <TextView
                style="@style/Halqa.Step"
                android:layout_marginTop="@dimen/step_text_offset"
                android:text="@string/mac_add_step_3" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:background="@drawable/mac_card_background"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mac_found_title"
            android:textColor="#B6BCC6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/mac_found_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/mac_searching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/mac_searching_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/waiting_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/mac_searching"
                android:textColor="#B6BCC6"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/mac_host_input"
            style="@style/Halqa.MacInput"
            android:layout_marginTop="16dp"
            android:hint="@string/mac_host_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/mac_user_input"
            style="@style/Halqa.MacInput"
            android:hint="@string/mac_user_hint"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/mac_password_input"
            style="@style/Halqa.MacInput"
            android:fontFamily="sans-serif"
            android:hint="@string/mac_password_hint"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/mac_share_input"
            style="@style/Halqa.MacInput"
            android:hint="@string/mac_share_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text"
            android:text="@string/mac_share_default" />

        <TextView
            android:id="@+id/mac_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Connect above Forget, both full width; the spinner shows inside Connect while it tries. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/mac_connect"
                style="@style/Halqa.Pill"
                android:layout_width="match_parent"
                android:background="@drawable/button_connect_background"
                android:text="@string/mac_connect"
                android:textColor="#FFFFFF" />

            <com.saiesh.tele.presentation.widget.SpinnerView
                android:id="@+id/mac_connecting"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:visibility="gone"
                app:spinnerColor="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/mac_forget"
            style="@style/Halqa.Pill"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_forget_background"
            android:text="@string/mac_forget"
            android:textColor="#FF8A80"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
